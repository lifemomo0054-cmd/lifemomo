# 공공데이터포털(data.go.kr) > 소상공인시장진흥공단_상가(상권)정보 > 마이페이지의 "일반 인증키"
# Encoding 키, Decoding 키 중 아무거나 넣어도 됩니다.
DATA_GO_KR_SERVICE_KEY=

# 서버 포트 (기본 3000)
# PORT=3000

# 한 번 조회할 때 최대 몇 페이지까지 불러올지 (1페이지 = 1,000개, 기본 10 → 최대 10,000개)
# 페이지 하나가 API 호출 1회이므로, 일일 호출 한도가 걱정되면 줄이세요.
# MAX_PAGES=10

# 서버가 받을 주소 (기본 127.0.0.1 = 이 컴퓨터에서만 접속 가능)
# 0.0.0.0 으로 바꾸면 같은 네트워크의 다른 기기도 접속할 수 있지만, 그 사람들도 내 키의 호출 한도를 쓰게 됩니다.
# HOST=127.0.0.1
